      <direction><direction-type><dynamics><p/></dynamics></direction-type></direction>
      <note><pitch><step>G</step><octave>5</octave></pitch><duration>6</duration><voice>1</voice><type>quarter</type><notations><slur type="start" number="1"/></notations></note>
