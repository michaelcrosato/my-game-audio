{
  "name": "my-game-audio",
  "version": "0.1.0",
  "description": "Game music, sound effects and voices written as code by LLM agents: a text score format, a synthesized orchestra and band, sheet-music importers, and a streaming renderer. No audio files.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "exports": { ".": "./engine/index.mjs" },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "golden": "node tools/golden.mjs",
    "render": "node tools/render.mjs",
    "bundle": "esbuild web/entry.mjs --bundle --format=iife --global-name=MyGameAudioDemo --outfile=web/bundle.js",
    "page": "npm run bundle && node web/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
