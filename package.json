{
  "name": "my-game-audio",
  "version": "0.23.0",
  "description": "Music composed by LLM agents as sheet music (ABC, MusicXML, Humdrum, MIDI or a text score) and rendered by code: a synthesized orchestra, band, piano and chip, checks an agent can read, and a player for games. No audio files.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./engine/index.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "golden": "node tools/golden.mjs",
    "render": "node tools/render.mjs",
    "build": "node tools/build.mjs",
    "page": "node tools/build.mjs && node web/build.mjs",
    "page:test": "node tools/page_test.mjs",
    "ears": "node tools/ears.mjs",
    "take": "node tools/takes.mjs save",
    "takes": "node tools/takes.mjs",
    "library": "node tools/library.mjs",
    "sfx": "node tools/sfx.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
