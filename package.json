  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./engine/index.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "golden": "node tools/golden.mjs",
    "render": "node tools/render.mjs",
    "build": "node tools/build.mjs",
    "page": "node tools/build.mjs && node web/build.mjs",
    "page:test": "node tools/page_test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
